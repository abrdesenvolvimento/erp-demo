{
  "query": "SELECT \n  s.id,\n  s.finalAmount,\n  SUM(si.quantity * si.unitPrice) as items_total,\n  CAST(s.finalAmount AS DECIMAL(10,2)) - SUM(si.quantity * si.unitPrice) as difference\nFROM sales s\nJOIN saleItems si ON s.id = si.saleId\nWHERE MONTH(CONVERT_TZ(s.saleDate, '+00:00', '-03:00')) = 12 \n  AND YEAR(CONVERT_TZ(s.saleDate, '+00:00', '-03:00')) = 2025\n  AND s.status != 'CANCELLED'\nGROUP BY s.id, s.finalAmount\nHAVING ABS(CAST(s.finalAmount AS DECIMAL(10,2)) - SUM(si.quantity * si.unitPrice)) > 0.01\nORDER BY difference DESC\nLIMIT 20;",
