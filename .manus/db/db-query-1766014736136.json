  "query": "SELECT \n  DATE(CONVERT_TZ(saleDate, '+00:00', '-03:00')) as sale_date_br,\n  COUNT(*) as num_sales,\n  SUM(CAST(finalAmount AS DECIMAL(10,2))) as total_revenue,\n  status\nFROM sales \nWHERE MONTH(CONVERT_TZ(saleDate, '+00:00', '-03:00')) = 12 \n  AND YEAR(CONVERT_TZ(saleDate, '+00:00', '-03:00')) = 2025\nGROUP BY DATE(CONVERT_TZ(saleDate, '+00:00', '-03:00')), status\nORDER BY sale_date_br DESC\nLIMIT 20;",
