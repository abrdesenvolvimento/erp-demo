{
  "query": "SELECT \n  'VENDA' as tipo,\n  s.id as id,\n  DATE_FORMAT(s.saleDate, '%d/%m/%Y %H:%i') as data,\n  CAST(s.finalAmount AS DECIMAL(10,2)) as valor\nFROM sales s\nJOIN partners p ON s.customerId = p.id\nWHERE p.name LIKE '%Victor Hugo%'\nAND s.saleType = 'A_PRAZO'\nAND s.status = 'ACTIVE'\nUNION ALL\nSELECT \n  'PAGAMENTO' as tipo,\n  cp.id as id,\n  DATE_FORMAT(cp.paidDate, '%d/%m/%Y %H:%i') as data,\n  CAST(cp.paidAmount AS DECIMAL(10,2)) as valor\nFROM customerPayments cp\nJOIN partners p ON cp.customerId = p.id\nWHERE p.name LIKE '%Victor Hugo%'\nORDER BY data;",
