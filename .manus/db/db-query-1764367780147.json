  "query": "\nSELECT \n  rp.id,\n  p.name as customer_name,\n  rp.paidAmount,\n  rp.paidDate as stored_utc,\n  DATE_FORMAT(rp.paidDate, '%d/%m/%Y %H:%i') as formatted_utc,\n  DATE_FORMAT(CONVERT_TZ(rp.paidDate, '+00:00', '-03:00'), '%d/%m/%Y %H:%i') as brasilia_time,\n  rp.paymentMethod\nFROM receivablePayments rp\nJOIN partners p ON rp.customerId = p.id\nORDER BY rp.paidDate DESC\nLIMIT 20\n",
